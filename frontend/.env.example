# AstraCare frontend: copy to frontend/.env.local (ignored by git).
# Only variables prefixed with VITE_ reach the browser, so never put secret keys here:
# GEMINI_API_KEY and NASA_API_KEY belong in backend/.env.

# Backend URL. Leave empty in development: the Vite proxy sends /api to http://localhost:8000.
# Set it when the frontend is served apart from the backend, e.g. https://api.example.org
VITE_API_BASE=
