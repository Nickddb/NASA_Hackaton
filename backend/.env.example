# AstraCare backend: copy this file to backend/.env and fill in what you need.
# backend/.env is loaded automatically at start-up (app/config.py) and is in .gitignore: never commit real keys.
# Variables already set in the shell / hosting platform take precedence over this file.

# --- LLM (optional) -------------------------------------------------------------------
# Without a key the chat agent runs the deterministic offline pipeline (same tools, same chain).
# Get a key at https://aistudio.google.com/apikey and install: pip install -r requirements-llm.txt
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as an alias of GEMINI_API_KEY
ASTRACARE_LLM_MODEL=gemini-2.5-flash
# How many rounds of tool calls the LLM may chain in one chat turn (exam -> diagnosis -> alert -> stimuli = 4)
ASTRACARE_LLM_MAX_TOOL_ROUNDS=5
# Timeout of each LLM call, in seconds (falls back to the offline pipeline when exceeded)
ASTRACARE_LLM_TIMEOUT_S=12

# --- NASA APIs ------------------------------------------------------------------------
# TODO: replace DEMO_KEY with your own key from https://api.nasa.gov/ (DEMO_KEY ~10 requests/hour on DONKI)
NASA_API_KEY=DEMO_KEY

# --- Autonomous smartwatch monitoring ---------------------------------------------------
# Background loop that runs scheduled exams through the full chain
ASTRACARE_SCHEDULER_ENABLED=true
# How often the loop checks for due exams, in seconds
ASTRACARE_SCHEDULER_TICK_S=30
# Do not re-send the same central alert for the same astronaut within this window, in minutes
ASTRACARE_ALERT_COOLDOWN_MIN=30

# --- Storage ----------------------------------------------------------------------------
# Folder for the mission ledger, follow-up cases and DONKI cache (default: backend/data)
# ASTRACARE_STATE_DIR=
