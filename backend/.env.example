# AstraCare backend: copy this file to backend/.env and fill in what you need.
# backend/.env is loaded automatically at start-up (app/config.py) and is in .gitignore: never commit real keys.
# Variables already set in the shell / hosting platform take precedence over this file.

# --- LLM (optional) -------------------------------------------------------------------
# Without a key the chat agent runs the deterministic offline pipeline (same tools, same chain).
# Provider: groq | gemini | offline. Empty = first one with a key (Groq first).
ASTRACARE_LLM_PROVIDER=

# Groq (free tier, OpenAI-compatible, no extra package): key at https://console.groq.com/keys
GROQ_API_KEY=
# Hide the model's <think> reasoning from the chat answer (hidden | parsed | raw; empty = Groq default)
ASTRACARE_GROQ_REASONING_FORMAT=hidden

# Gemini: key at https://aistudio.google.com/apikey and install: pip install -r requirements-llm.txt
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted as an alias of GEMINI_API_KEY

# Model of the chosen provider. Empty = qwen/qwen3.8-27b on Groq, gemini-2.5-flash on Gemini.
# Groq IDs: https://console.groq.com/docs/models (preview models can be retired at short notice)
ASTRACARE_LLM_MODEL=
# How many rounds of tool calls the LLM may chain in one chat turn (exam -> diagnosis -> alert -> stimuli = 4)
ASTRACARE_LLM_MAX_TOOL_ROUNDS=5
# Timeout of each LLM call, in seconds (falls back to the offline pipeline when exceeded)
ASTRACARE_LLM_TIMEOUT_S=30
# Tools offered to the LLM (comma list or "all"). Default = monitoring chain + DONKI + sleep/mood check-in,
# because every round resends the tool schemas and Groq's free tier allows 8k tokens/minute.
# ASTRACARE_LLM_TOOLS=all
# Tool results longer than this are cut before going back to the model
ASTRACARE_LLM_TOOL_RESULT_MAX_CHARS=1200
# On HTTP 429 wait the provider's retry-after (if <= MAX_WAIT_S) and retry
ASTRACARE_GROQ_RATE_LIMIT_RETRIES=2
ASTRACARE_GROQ_RATE_LIMIT_MAX_WAIT_S=8

# --- NASA APIs ------------------------------------------------------------------------
# TODO: replace DEMO_KEY with your own key from https://api.nasa.gov/ (DEMO_KEY ~10 requests/hour on DONKI)
NASA_API_KEY=DEMO_KEY
# NASA DONKI + JPL Horizons refresh period, in minutes (JPL Horizons needs no key)
ASTRACARE_NASA_REFRESH_MIN=30

# --- Autonomous smartwatch monitoring ---------------------------------------------------
# Background loop that runs scheduled exams through the full chain
ASTRACARE_SCHEDULER_ENABLED=true
# How often the loop checks for due exams, in seconds
ASTRACARE_SCHEDULER_TICK_S=30
# Do not re-send the same central alert for the same astronaut within this window, in minutes
ASTRACARE_ALERT_COOLDOWN_MIN=30

# --- Storage ----------------------------------------------------------------------------
# Folder for the mission ledger, follow-up cases and DONKI cache (default: backend/data)
# ASTRACARE_STATE_DIR=
